{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.1.0.0",
    "metadata": {
        "description": "Windows Server 2025 VM (Corp LZ) mit OSConfig-Baseline.",
        "moreInformation": "https://github.com/thinformatics/azure-lz-templates",
        "category": "Compute/VirtualMachines"
    },
    "parameters": {
        "name": {
            "type": "string",
            "defaultValue": "fileserver",
            "minLength": 3,
            "maxLength": 11,
            "metadata": {
                "description": "Rollenbasierter Kurzname der VM (ohne Stage und Nummer), z. B. webserver, fileserver."
            }
        },
        "stage": {
            "type": "string",
            "defaultValue": "dev",
            "allowedValues": [
                "dev",
                "tst",
                "preprod",
                "prod"
            ],
            "metadata": {
                "description": "Stage/Umgebung fuer Namenskonventionen (dev, tst, preprod, prod)."
            }
        },
        "identifier": {
            "type": "string",
            "defaultValue": "001",
            "minLength": 3,
            "maxLength": 3,
            "metadata": {
                "description": "Dreistellige Nummer fuer Namenskonventionen, z.B. 001, 002 etc."
            }
        },
        "vmSize": {
            "type": "string",
            "defaultValue": "Standard_B2s_v2",
            "metadata": {
                "description": "VM-Groesse der virtuellen Maschine, z.B. Standard_B2s_v2"
            }
        },
        "diskStorageType": {
            "type": "string",
            "defaultValue": "Standard SSD — LRS (Lokalredundant / Allround)",
            "allowedValues": [
                "Standard HDD — LRS (Lokalredundant / Geringe I/O)",
                "Standard SSD — LRS (Lokalredundant / Allround)",
                "Premium SSD — LRS  (Lokalredundant / hohe I/O)",
                "Standard SSD — ZRS (Zonenredundant in der Region)",
                "Premium SSD — ZRS  (Zonenredundant in der Region)"
            ],
            "metadata": {
                "description": "OS-SpeicherTyp. Die Region hat drei Zonen / Separate Rechenzentren."
            }
        },
        "osDiskSizeGiB": {
            "type": "int",
            "defaultValue": 64,
            "allowedValues": [
                64,
                128,
                256,
                512,
                1024
            ],
            "metadata": {
                "description": "Groesse der OS-Disk in GiB - Die Groessen koennen im Template beliebig angepasst werden."
            }
        },
        "adminUsername": {
            "type": "string",
            "metadata": {
                "description": "Lokaler Admin-Benutzername"
            }
        },
        "adminPassword": {
            "type": "securestring",
            "minLength": 12,
            "metadata": {
                "description": "Sicheres Passwort fuer den lokalen Administrator: mindestens 12 Zeichen, mit mindestens einem Grossbuchstaben, einem Kleinbuchstaben, einer Zahl und einem Sonderzeichen."
            }
        },
        "scenario": {
            "type": "string",
            "allowedValues": [
                "Member Server - Windows Server in Domäne (z.B. Fileserver)",
                "Workgroup Member - Windows Server ohne Domäne",
                "Domain Controller - Speziell für Active Directory Domain Controller"
            ],
            "metadata": {
                "description": "OS-Config-Szenario in dem die VM vorkonfiguriert werden soll."
            }
        },
        "networkMode": {
            "type": "string",
            "defaultValue": "new",
            "allowedValues": [
                "existing",
                "new"
            ],
            "metadata": {
                "description": "new = eigenes VNet, existing = bestehendes Subnetz"
            }
        },
        "existingSubnetId": {
            "type": "string",
            "defaultValue": "",
            "metadata": {
                "description": "Resource-ID des bestehenden Subnetzes (nur bei existing)"
            }
        },
        "attachNicNsg": {
            "type": "bool",
            "defaultValue": false,
            "metadata": {
                "description": "Leere NSG an die Netzwerkkarte haengen (nur bei existing)"
            }
        },
        "addressPrefix": {
            "type": "string",
            "defaultValue": "10.10.0.0/16",
            "metadata": {
                "description": "Address Space des VNET (CIDR)"
            }
        },
        "subnetPrefix": {
            "type": "string",
            "defaultValue": "10.10.1.0/24",
            "metadata": {
                "description": "Subnetz-Praefix fuer default (CIDR)"
            }
        },
        "enableAcceleratedNetworking": {
            "type": "bool",
            "defaultValue": true,
            "metadata": {
                "description": "Accelerated Networking aktivieren"
            }
        }
    },
    "variables": {
        "vmName": "[concat('vm-', parameters('name'), '-', toLower(parameters('stage')), '-', parameters('identifier'))]",
        "vmHostname": "[concat(parameters('name'), '-', parameters('identifier'))]",
        "stageLower": "[toLower(parameters('stage'))]",
        "nicName": "[concat('nic-', parameters('name'), '-', variables('stageLower'), '-', parameters('identifier'))]",
        "vnetName": "[concat('vnet-', parameters('name'), '-', variables('stageLower'), '-', parameters('identifier'))]",
        "subnetName": "default",
        "nsgName": "[concat('nsg-', parameters('name'), '-', variables('stageLower'), '-', parameters('identifier'))]",
        "osDiskName": "[concat('osdisk-', parameters('name'), '-', variables('stageLower'), '-', parameters('identifier'))]",
        "diskSkuMap": {
            "Standard HDD — LRS (Lokalredundant / Geringe I/O)": "Standard_LRS",
            "Standard SSD — LRS (Lokalredundant / Allround)": "StandardSSD_LRS",
            "Premium SSD — LRS  (Lokalredundant / hohe I/O)": "Premium_LRS",
            "Standard SSD — ZRS (Zonenredundant in der Region)": "StandardSSD_ZRS",
            "Premium SSD — ZRS  (Zonenredundant in der Region)": "Premium_ZRS"
        },
        "diskStorageSku": "[variables('diskSkuMap')[parameters('diskStorageType')]]",
        "scenarioMap": {
            "Member Server - Windows Server in Domäne (z.B. Fileserver)": "MemberServer",
            "Workgroup Member - Windows Server ohne Domäne": "WorkgroupMember",
            "Domain Controller - Speziell für Active Directory Domain Controller": "DomainController"
        },
        "OsConfigScenario": "[variables('scenarioMap')[parameters('scenario')]]",
        "isNewNetwork": "[equals(parameters('networkMode'), 'new')]",
        "deployNsg": "[or(variables('isNewNetwork'), parameters('attachNicNsg'))]",
        "subnetId": "[if(variables('isNewNetwork'), resourceId('Microsoft.Network/virtualNetworks/subnets', variables('vnetName'), variables('subnetName')), parameters('existingSubnetId'))]"
    },
    "resources": [
        {
            "condition": "[variables('deployNsg')]",
            "type": "Microsoft.Network/networkSecurityGroups",
            "apiVersion": "2025-05-01",
            "name": "[variables('nsgName')]",
            "location": "germanywestcentral",
            "properties": {
                "securityRules": []
            }
        },
        {
            "condition": "[variables('isNewNetwork')]",
            "type": "Microsoft.Network/virtualNetworks",
            "apiVersion": "2025-05-01",
            "name": "[variables('vnetName')]",
            "location": "germanywestcentral",
            "properties": {
                "addressSpace": {
                    "addressPrefixes": [
                        "[parameters('addressPrefix')]"
                    ]
                },
                "subnets": [
                    {
                        "name": "[variables('subnetName')]",
                        "properties": {
                            "addressPrefix": "[parameters('subnetPrefix')]",
                            "networkSecurityGroup": {
                                "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgName'))]"
                            },
                            "defaultOutboundAccess": true
                        }
                    }
                ]
            },
            "dependsOn": [
                "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgName'))]"
            ]
        },
        {
            "type": "Microsoft.Network/networkInterfaces",
            "apiVersion": "2025-05-01",
            "name": "[variables('nicName')]",
            "location": "germanywestcentral",
            "properties": {
                "ipConfigurations": [
                    {
                        "name": "ipconfig1",
                        "properties": {
                            "subnet": {
                                "id": "[variables('subnetId')]"
                            },
                            "privateIPAllocationMethod": "Dynamic"
                        }
                    }
                ],
                "enableAcceleratedNetworking": "[parameters('enableAcceleratedNetworking')]",
                "networkSecurityGroup": "[if(and(not(variables('isNewNetwork')), parameters('attachNicNsg')), createObject('id', resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgName'))), null())]"
            },
            "dependsOn": [
                "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]",
                "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgName'))]"
            ]
        },
        {
            "type": "Microsoft.Compute/virtualMachines",
            "apiVersion": "2025-04-01",
            "name": "[variables('vmName')]",
            "location": "germanywestcentral",
            "identity": {
                "type": "SystemAssigned"
            },
            "properties": {
                "securityProfile": {
                    "encryptionAtHost": true,
                    "securityType": "TrustedLaunch",
                    "uefiSettings": {
                        "secureBootEnabled": true,
                        "vTpmEnabled": true
                    }
                },
                "hardwareProfile": {
                    "vmSize": "[parameters('vmSize')]"
                },
                "osProfile": {
                    "computerName": "[variables('vmHostname')]",
                    "adminUsername": "[parameters('adminUsername')]",
                    "adminPassword": "[parameters('adminPassword')]",
                    "windowsConfiguration": {
                        "enableAutomaticUpdates": true,
                        "provisionVMAgent": true,
                        "patchSettings": {
                            "patchMode": "AutomaticByPlatform",
                            "assessmentMode": "AutomaticByPlatform",
                            "enableHotpatching": false,
                            "automaticByPlatformSettings": {
                                "rebootSetting": "IfRequired"
                            }
                        }
                    }
                },
                "storageProfile": {
                    "imageReference": {
                        "publisher": "MicrosoftWindowsServer",
                        "offer": "WindowsServer",
                        "sku": "2025-datacenter-g2",
                        "version": "latest"
                    },
                    "osDisk": {
                        "name": "[variables('osDiskName')]",
                        "createOption": "FromImage",
                        "diskSizeGB": "[parameters('osDiskSizeGiB')]",
                        "managedDisk": {
                            "storageAccountType": "[variables('diskStorageSku')]"
                        },
                        "deleteOption": "Delete"
                    }
                },
                "networkProfile": {
                    "networkInterfaces": [
                        {
                            "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('nicName'))]",
                            "properties": {
                                "deleteOption": "Delete"
                            }
                        }
                    ]
                },
                "diagnosticsProfile": {
                    "bootDiagnostics": {
                        "enabled": true
                    }
                }
            },
            "dependsOn": [
                "[resourceId('Microsoft.Network/networkInterfaces', variables('nicName'))]"
            ]
        },
        {
            "type": "Microsoft.Compute/virtualMachines/extensions",
            "apiVersion": "2025-04-01",
            "name": "[concat(variables('vmName'), '/CustomScriptExtension-OSConfig')]",
            "location": "germanywestcentral",
            "properties": {
                "publisher": "Microsoft.Compute",
                "type": "CustomScriptExtension",
                "typeHandlerVersion": "1.10",
                "autoUpgradeMinorVersion": true,
                "settings": {},
                "protectedSettings": {
                    "fileUris": [
                        "https://raw.githubusercontent.com/thinformatics/azure-lz-templates/refs/heads/main/utils/Initialize-OSConfig.ps1"
                    ],
                    "commandToExecute": "[concat('powershell -ExecutionPolicy Bypass -NoProfile -NonInteractive -File Initialize-OSConfig.ps1 -Scenario ', variables('OsConfigScenario'))]"
                }
            },
            "dependsOn": [
                "[resourceId('Microsoft.Compute/virtualMachines', variables('vmName'))]"
            ]
        }
    ],
    "outputs": {
        "privateIpAddress": {
            "type": "string",
            "value": "[reference(resourceId('Microsoft.Network/networkInterfaces', variables('nicName'))).ipConfigurations[0].properties.privateIPAddress]"
        }
    }
}
